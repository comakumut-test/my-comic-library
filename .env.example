# Cloudflare R2 (file storage) — required
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=comics

# Metron (News page and comic search) — optional
METRON_USERNAME=
METRON_PASSWORD=
# METRON_TOKEN=            (a token also works instead of username/password)

# Comic Vine (automatic fallback if Metron is down) — optional
# COMICVINE_API_KEY=

# Secret used to sign session cookies — optional
# (falls back to R2_SECRET_ACCESS_KEY). This is NOT the site password:
# the site password is chosen on the site at first sign-in.
# APP_PASSWORD=
